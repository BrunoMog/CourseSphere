# CourseSphere Environment Variables Example
FLASK_DEBUG=0
PORT=5000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Secret key for HMAC message signing and session integrity (CSPRNG)
COURSESPHERE_SECRET_KEY=change-this-in-production-use-a-strong-random-secret

# Database path (defaults to local SQLite within backend directory)
COURSESPHERE_DB_PATH=cornell-course-sphere-data/roster_reviews.sqlite.db

# Optional 3rd-party Services (loaded from env, never hardcoded in repository)
OPENAI_API_KEY=your-openai-api-key-here
FIREBASE_CREDENTIALS_PATH=./credentials.json
FIREBASE_DATABASE_URL=https://coursesphere-8bd9a-default-rtdb.firebaseio.com
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
