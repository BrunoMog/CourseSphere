# CourseSphere Environment Configuration Template
# Copy this file to .env and populate with strong secrets before running in production:
#   cp .env.example .env
#   openssl rand -hex 32

# Cryptographic key used to sign session tokens and message IDs (REQUIRED in production)
COURSESPHERE_SECRET_KEY=

# Environment mode: development | production
COURSESPHERE_ENV=development
FLASK_DEBUG=0

# Optional external service credentials
OPENAI_API_KEY=
FIREBASE_CREDENTIALS_PATH=./credentials.json
FIREBASE_DATABASE_URL=https://coursesphere-8bd9a-default-rtdb.firebaseio.com

# Optional Reddit Crawler credentials (never hardcode in source code)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=CourseSphereAuditBot/1.0
REDDIT_USERNAME=
REDDIT_PASSWORD=
